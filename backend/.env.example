# ──────────────────────────────────────────────
# Finclusion AI — Backend Environment Variables
# ──────────────────────────────────────────────

# AI Provider: "openai" | "fingpt" | "ollama" | "none"
# "none" → the chatbot returns an educational placeholder and explains what is missing
AI_PROVIDER=openai

# ---------- OpenAI / Azure OpenAI ----------
# Obtain at: https://platform.openai.com/api-keys
# Required when AI_PROVIDER=openai
LLM_API_KEY=sk-...
# Model to use (gpt-4o-mini is cheap and finance-aware)
MODEL_ID=gpt-4o-mini
# Optional: base URL for Azure OpenAI or local OpenAI-compatible server (e.g. Ollama)
# LLM_BASE_URL=http://localhost:11434/v1

# ---------- FinGPT via Hugging Face Inference API ----------
# Obtain at: https://huggingface.co/settings/tokens
# Required when AI_PROVIDER=fingpt
# NOTE: fingpt models may require a HF Pro subscription or gated model access.
# The default model is FinGPT/fingpt-forecaster_dow30_llama2-7b_lora
# which requires accepting the model license on huggingface.co
HUGGINGFACE_TOKEN=hf_...
FINGPT_MODEL_ID=FinGPT/fingpt-forecaster_dow30_llama2-7b_lora

# ---------- Ollama (local) ----------
# When AI_PROVIDER=ollama, set:
# LLM_BASE_URL=http://localhost:11434/v1
# MODEL_ID=llama3.2   (or any model you have pulled: ollama pull llama3.2)
# LLM_API_KEY=ollama  (any non-empty string)

# ---------- News ----------
# Obtain a free key at: https://newsapi.org/register
# If missing, the news endpoint returns a configuration message (no fake news)
NEWS_API_KEY=

# ---------- Database ----------
DATABASE_URL=sqlite+aiosqlite:///./finclusion.db

# ---------- App ----------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_SECRET=change-me-to-a-random-string
